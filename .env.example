NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase PostgreSQL pooler connection for application queries
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase direct PostgreSQL connection for migrations/schema operations
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Optional: shared Redis for rate limiting across multiple instances.
# Leave unset to use the built-in per-process in-memory limiter.
REDIS_URL=
