generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  isSystem  Boolean  @default(false) @map("is_system")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users         User[]
  subscriptions Subscription[]
  customers     Customer[]
  drivers       Driver[]
  orders        Order[]
  products      Product[]
  payments      Payment[]
  impersonationLogs ImpersonationLog[]
  scheduleAssignments ScheduleAssignment[]
  assets             Asset[]
  maintenanceRecords MaintenanceRecord[]

  @@map("factories")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  role           UserRole @default(STAFF)
  factoryId      String?  @map("factory_id")
  factory        Factory? @relation(fields: [factoryId], references: [id])
  isFactoryOwner Boolean  @default(false) @map("is_factory_owner")
  assignedOrders Order[]  @relation("OrderAssigner")
  payments       Payment[]
  impersonationLogs ImpersonationLog[]
  driverProfile  Driver?  @relation("DriverUser")
  scheduleAssignments ScheduleAssignment[]

  @@index([factoryId])
  @@map("users")
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  sizeKg                 Int
  unit                   String                  @default("bag")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  factoryId              String                  @map("factory_id")
  factory                Factory                 @relation(fields: [factoryId], references: [id])
  customerPriceOverrides CustomerPriceOverride[]
  globalPrices           GlobalPrice?
  inventory              Inventory[]
  orderItems             OrderItem[]

  @@index([factoryId])
  @@map("products")
}

model Customer {
  id                     String                  @id @default(cuid())
  code                   String
  name                   String
  address                String
  phone                  String
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  factoryId              String                  @map("factory_id")
  factory                Factory                 @relation(fields: [factoryId], references: [id])
  debtLedger             CustomerDebtLedger[]
  customerPriceOverrides CustomerPriceOverride[]
  shellDeposit           CustomerShellDeposit?
  orders                 Order[]

  @@unique([code, factoryId])
  @@index([factoryId])
  @@map("customers")
}

model GlobalPrice {
  id           String   @id @default(cuid())
  productId    String   @unique @map("product_id")
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id])

  @@map("global_prices")
}

model CustomerPriceOverride {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  productId    String   @map("product_id")
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("customer_price_overrides")
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  token     String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  phone     String?
  factoryId String   @map("factory_id")
  userId    String?  @unique @map("user_id")
  factory   Factory  @relation(fields: [factoryId], references: [id])
  user      User?    @relation("DriverUser", fields: [userId], references: [id])
  orders    Order[]

  @@unique([phone, factoryId])
  @@index([factoryId])
  @@map("drivers")
}

model ScheduleAssignment {
  id        String   @id @default(cuid())
  factoryId String   @map("factory_id")
  userId    String   @map("user_id")
  shiftDate DateTime @map("shift_date") @db.Date
  shift     Shift
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  factory   Factory  @relation(fields: [factoryId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftDate, shift])
  @@index([factoryId, shiftDate])
  @@index([userId])
  @@map("schedule_assignments")
}

model Order {
  id          String      @id @default(cuid())
  customerId  String      @map("customer_id")
  status      OrderStatus @default(PENDING)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  driverId    String?     @map("driver_id")
  assignerId  String?     @map("assigner_id")
  deliveryLat Float?      @map("delivery_lat")
  deliveryLng Float?      @map("delivery_lng")
  deliveredAt DateTime?   @map("delivered_at")
  deliveryGps Json?       @map("delivery_gps")
  factoryId   String      @map("factory_id")
  factory     Factory     @relation(fields: [factoryId], references: [id])
  orderItems  OrderItem[]
  assigner    User?       @relation("OrderAssigner", fields: [assignerId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  driver      Driver?     @relation(fields: [driverId], references: [id])

  @@index([customerId])
  @@index([driverId])
  @@index([status, createdAt])
  @@index([factoryId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)
  actualQty Int?    @map("actual_qty")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CustomerDebtLedger {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  type       LedgerType
  amount     Decimal    @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  customer   Customer   @relation(fields: [customerId], references: [id])

  @@map("customer_debt_ledger")
}

model CustomerShellDeposit {
  id              String   @id @default(cuid())
  customerId      String   @unique @map("customer_id")
  shellsOut       Int      @default(0)
  shellsIn        Int      @default(0)
  depositPerShell Decimal  @default(50000) @map("deposit_per_shell") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  customer        Customer @relation(fields: [customerId], references: [id])

  @@map("customer_shell_deposits")
}

model Payment {
  id          String   @id @default(cuid())
  factoryId   String   @map("factory_id")
  amount      Decimal  @db.Decimal(10, 2)
  adminId     String   @map("admin_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  notes       String?
  factory     Factory  @relation(fields: [factoryId], references: [id])
  admin       User     @relation(fields: [adminId], references: [id])

  @@index([factoryId])
  @@index([adminId])
  @@index([confirmedAt])
  @@map("payments")
}

model Inventory {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  date           DateTime @default(now()) @map("date")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([productId, date])
  @@map("inventory")
}

model ImpersonationLog {
  id           String   @id @default(cuid())
  superAdminId String   @map("super_admin_id")
  factoryId    String   @map("factory_id")
  token        String   @unique @default(uuid())
  startedAt    DateTime @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  superAdmin   User     @relation(fields: [superAdminId], references: [id])
  factory      Factory  @relation(fields: [factoryId], references: [id])

  @@index([superAdminId])
  @@index([factoryId])
  @@index([token])
  @@map("impersonation_logs")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  STAFF
  DRIVER
  SUPER_ADMIN
}

enum SubscriptionPlan {
  TRIAL
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id             String             @id @default(cuid())
  factoryId      String             @map("factory_id")
  planType       SubscriptionPlan   @default(TRIAL) @map("plan_type")
  startDate      DateTime           @default(now()) @map("start_date")
  endDate        DateTime           @map("end_date")
  status         SubscriptionStatus @default(ACTIVE)
  driverCount    Int                @default(0) @map("driver_count")
  pricePerDriver Decimal?           @map("price_per_driver") @db.Decimal(10, 2)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  factory        Factory            @relation(fields: [factoryId], references: [id])

  @@index([factoryId])
  @@map("subscriptions")
}

enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Shift {
  SLOT_00_03
  SLOT_03_06
  SLOT_06_09
  SLOT_09_12
  SLOT_12_15
  SLOT_15_18
  SLOT_18_21
  SLOT_21_24
}

enum LedgerType {
  DEBT
  PAYMENT
}

enum AssetType {
  MACHINE
  VEHICLE
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  INACTIVE
}

enum MaintenanceType {
  ROUTINE
  INSPECTION
  INSURANCE
  REPAIR
}

model Asset {
  id           String   @id @default(cuid())
  factoryId    String   @map("factory_id")
  factory      Factory  @relation(fields: [factoryId], references: [id])
  type         AssetType
  name         String
  code         String
  licensePlate String?  @map("license_plate")
  capacityTons Float?   @map("capacity_tons")
  status       AssetStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  maintenanceRecords MaintenanceRecord[]

  @@unique([factoryId, code])
  @@index([factoryId])
  @@map("assets")
}

model MaintenanceRecord {
  id          String @id @default(cuid())
  factoryId   String @map("factory_id")
  factory     Factory @relation(fields: [factoryId], references: [id])
  assetId     String @map("asset_id")
  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  performedAt DateTime @map("performed_at")
  dueAt       DateTime? @map("due_at")
  cost        Float?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([factoryId, dueAt])
  @@index([assetId])
  @@map("maintenance_records")
}
