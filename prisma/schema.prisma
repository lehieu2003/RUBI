generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  // Self-registration limits per 3-hour shift; null = no limit
  maxStaffPerShift   Int? @map("max_staff_per_shift")
  maxDriversPerShift Int? @map("max_drivers_per_shift")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users         User[]
  customers     Customer[]
  drivers       Driver[]
  orders        Order[]
  stockCounts   StockCount[]
  products      Product[]
  scheduleAssignments ScheduleAssignment[]
  assets             Asset[]
  maintenanceRecords MaintenanceRecord[]
  payrollLocks       PayrollLock[]
  auditLogs          AuditLog[]
  idempotencyKeys    IdempotencyKey[]

  @@map("factories")
}

// A closed payroll month: its shifts can no longer be changed by anyone
// until the manager reopens it.
model PayrollLock {
  id        String   @id @default(cuid())
  factoryId String   @map("factory_id")
  month     String   // YYYY-MM
  lockedAt  DateTime @default(now()) @map("locked_at")
  factory   Factory  @relation(fields: [factoryId], references: [id])

  @@unique([factoryId, month])
  @@map("payroll_locks")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  role           UserRole @default(STAFF)
  factoryId      String?  @map("factory_id")
  factory        Factory? @relation(fields: [factoryId], references: [id])
  isFactoryOwner Boolean  @default(false) @map("is_factory_owner")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  assignedOrders Order[]  @relation("OrderAssigner")
  driverProfile  Driver?  @relation("DriverUser")
  stockCounts    StockCount[]
  scheduleAssignments ScheduleAssignment[]

  @@index([factoryId])
  @@map("users")
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  sizeKg                 Int
  unit                   String                  @default("bag")
  // Low-stock alert: warn when what can still be sold is at or below this; null = no alert
  minStock               Int?                    @map("min_stock")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  factoryId              String                  @map("factory_id")
  factory                Factory                 @relation(fields: [factoryId], references: [id])
  customerPriceOverrides CustomerPriceOverride[]
  globalPrices           GlobalPrice?
  inventory              Inventory[]
  orderItems             OrderItem[]
  stockCounts            StockCount[]

  @@index([factoryId])
  @@map("products")
}

model Customer {
  id                     String                  @id @default(cuid())
  code                   String
  name                   String
  address                String
  phone                  String
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  factoryId              String                  @map("factory_id")
  factory                Factory                 @relation(fields: [factoryId], references: [id])
  debtLedger             CustomerDebtLedger[]
  customerPriceOverrides CustomerPriceOverride[]
  shellDeposit           CustomerShellDeposit?
  orders                 Order[]

  @@unique([code, factoryId])
  @@index([factoryId])
  @@map("customers")
}

model GlobalPrice {
  id           String   @id @default(cuid())
  productId    String   @unique @map("product_id")
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id])

  @@map("global_prices")
}

model CustomerPriceOverride {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  productId    String   @map("product_id")
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(10, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("customer_price_overrides")
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  phone     String?
  factoryId String   @map("factory_id")
  userId    String?  @unique @map("user_id")
  factory   Factory  @relation(fields: [factoryId], references: [id])
  user      User?    @relation("DriverUser", fields: [userId], references: [id])
  orders    Order[]

  @@unique([phone, factoryId])
  @@index([factoryId])
  @@map("drivers")
}

model ScheduleAssignment {
  id        String   @id @default(cuid())
  factoryId String   @map("factory_id")
  userId    String   @map("user_id")
  shiftDate DateTime @map("shift_date") @db.Date
  shift     Shift
  status    ShiftStatus @default(APPROVED)
  reviewedAt DateTime? @map("reviewed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  factory   Factory  @relation(fields: [factoryId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftDate, shift])
  @@index([factoryId, shiftDate])
  @@index([userId])
  @@map("schedule_assignments")
}

model Order {
  id          String      @id @default(cuid())
  customerId  String      @map("customer_id")
  status      OrderStatus @default(PENDING)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  driverId    String?     @map("driver_id")
  assignerId  String?     @map("assigner_id")
  deliveredAt DateTime?   @map("delivered_at")
  // When the order was settled (đối soát); null until it is COMPLETED
  completedAt DateTime?   @map("completed_at")
  factoryId   String      @map("factory_id")
  factory     Factory     @relation(fields: [factoryId], references: [id])
  orderItems  OrderItem[]
  assigner    User?       @relation("OrderAssigner", fields: [assignerId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  driver      Driver?     @relation(fields: [driverId], references: [id])

  @@index([customerId])
  @@index([driverId])
  @@index([status, createdAt])
  @@index([factoryId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)
  actualQty Int?    @map("actual_qty")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CustomerDebtLedger {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  type       LedgerType
  amount     Decimal    @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  customer   Customer   @relation(fields: [customerId], references: [id])

  @@map("customer_debt_ledger")
}

model CustomerShellDeposit {
  id              String   @id @default(cuid())
  customerId      String   @unique @map("customer_id")
  shellsOut       Int      @default(0)
  shellsIn        Int      @default(0)
  depositPerShell Decimal  @default(50000) @map("deposit_per_shell") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  customer        Customer @relation(fields: [customerId], references: [id])

  @@map("customer_shell_deposits")
}

model Inventory {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  date           DateTime @default(now()) @map("date")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([productId, date])
  @@map("inventory")
}

// One row per stock count: what should have been in the cold store (the
// books minus orders out for delivery, not settled yet), what was counted, and
// who counted. The difference is the loss (melting, breakage) or surplus.
model StockCount {
  id              String   @id @default(cuid())
  factoryId       String   @map("factory_id")
  productId       String   @map("product_id")
  bookQuantity    Int      @map("book_quantity")
  countedQuantity Int      @map("counted_quantity")
  note            String?
  countedById     String?  @map("counted_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  factory         Factory  @relation(fields: [factoryId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  countedBy       User?    @relation(fields: [countedById], references: [id])

  @@index([factoryId, createdAt])
  @@map("stock_counts")
}

enum UserRole {
  ADMIN
  STAFF
  DRIVER
}

enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}

// PENDING: requested by the person, waiting for the manager.
// Only APPROVED shifts count towards the shift report.
enum ShiftStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Shift {
  SLOT_00_03
  SLOT_03_06
  SLOT_06_09
  SLOT_09_12
  SLOT_12_15
  SLOT_15_18
  SLOT_18_21
  SLOT_21_24
}

enum LedgerType {
  DEBT
  PAYMENT
}

enum AssetType {
  MACHINE
  VEHICLE
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  INACTIVE
}

enum MaintenanceType {
  ROUTINE
  INSPECTION
  INSURANCE
  REPAIR
}

model Asset {
  id           String   @id @default(cuid())
  factoryId    String   @map("factory_id")
  factory      Factory  @relation(fields: [factoryId], references: [id])
  type         AssetType
  name         String
  code         String
  licensePlate String?  @map("license_plate")
  capacityTons Float?   @map("capacity_tons")
  status       AssetStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  maintenanceRecords MaintenanceRecord[]

  @@unique([factoryId, code])
  @@index([factoryId])
  @@map("assets")
}

model MaintenanceRecord {
  id          String @id @default(cuid())
  factoryId   String @map("factory_id")
  factory     Factory @relation(fields: [factoryId], references: [id])
  assetId     String @map("asset_id")
  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  performedAt DateTime @map("performed_at")
  dueAt       DateTime? @map("due_at")
  cost        Float?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([factoryId, dueAt])
  @@index([assetId])
  @@map("maintenance_records")
}

// Who did what to an order or to a customer's debt. Written together with the
// change and never edited. No foreign keys to users, orders or customers: the
// history must outlive them, and the person's name is copied in.
model AuditLog {
  id         String      @id @default(cuid())
  factoryId  String      @map("factory_id")
  action     AuditAction
  userId     String?     @map("user_id")
  userName   String      @map("user_name")
  orderId    String?     @map("order_id")
  customerId String?     @map("customer_id")
  summary    String
  createdAt  DateTime    @default(now()) @map("created_at")
  factory    Factory     @relation(fields: [factoryId], references: [id])

  @@index([factoryId, createdAt])
  @@index([orderId])
  @@index([customerId])
  @@map("audit_logs")
}

// One submission of a write that adds to a balance (a payment, shells
// handed out, a production batch), named by the Idempotency-Key the client
// sends. Inserted first, in the same transaction as the write, so a resend of
// the same submission waits on the unique index and then gets the stored
// answer instead of writing again. Only successful writes are kept.
model IdempotencyKey {
  id          String   @id @default(cuid())
  factoryId   String   @map("factory_id")
  key         String
  // "METHOD path" of the write, e.g. "PATCH /api/deposits/shells"
  scope       String
  // sha256 of the validated request body
  requestHash String   @map("request_hash")
  // HTTP status and JSON body of the first answer; set before commit
  status      Int?
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  factory     Factory  @relation(fields: [factoryId], references: [id])

  @@unique([factoryId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum AuditAction {
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  ORDER_DELIVERED
  ORDER_SETTLED
  DEBT_PAYMENT
}
